{
  "name": "pochito",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "triggers": {"crons": ["* * * * *"]},
  "d1_databases": [{"binding": "DB", "database_name": "pochito", "database_id": "06aa2135-9d1c-4e60-80fc-a365622b2d7f", "migrations_dir": "migrations"}]
}
